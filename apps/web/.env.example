# Public browser credentials from Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Default: link. Use code only after configuring the email template and SMTP.
NEXT_PUBLIC_SUPABASE_EMAIL_MODE=link

# Usage events are enabled automatically on Vercel production deployments.
# Leave blank for that default, true for local testing, or false to disable.
NEXT_PUBLIC_USAGE_TRACKING=
